# Copy to .env (gitignored). Every value can also be set as a real env var.
LEADS_ENV=dev
LEADS_DATABASE_URL=postgresql://leads:leads@localhost:5433/frontdesk_leads
# Only used by `pytest -m db`; the tests create and drop their own schema.
TEST_DATABASE_URL=postgresql://leads:leads@localhost:5433/frontdesk_leads_test
LEADS_DATA_DIR=./data
LEADS_CONFIG_DIR=./config
LEADS_LOG_LEVEL=INFO
# json for machines, console for humans
LEADS_LOG_FORMAT=json

# Model names are config, never hardcoded. These override config/models.yaml.
# LEADS_SCORING_MODEL=
# LEADS_OPENER_MODEL=

# Hard cap for any single run, in USD. A run stops when it would exceed this.
LEADS_RUN_BUDGET_USD=0
# Defaults to dry-run; a run spends money only when this is explicitly false.
LEADS_DRY_RUN=true

# Secrets (added in the stage that first needs them; never commit values):
# ANTHROPIC_API_KEY=
# PHONE_LOOKUP_API_KEY=
# EMAIL_VERIFY_API_KEY=
