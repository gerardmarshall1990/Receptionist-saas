# Copy to .env (never commit .env). All optional; the tool runs without them.

# LINZ Data Service API key (free: data.linz.govt.nz > account > API keys, scope "Full access to
# tables and layers"). Enables authoritative title type + building outlines. Without it, title
# type stays "unverified" unless the council record shows cross-lease / unit title.
LINZ_API_KEY=

# Trade Me API (stub only; fill once your app is approved at developer.trademe.co.nz)
TRADEME_CONSUMER_KEY=
TRADEME_CONSUMER_SECRET=
TRADEME_OAUTH_TOKEN=
TRADEME_OAUTH_TOKEN_SECRET=

# Optional: use a different config file
# GSF_CONFIG=/path/to/config.yaml
